---
---

<!-- shared inner-card code styling handled via .feature-code in <style> below -->

<section id="features" class="py-14 md:py-24">
    <div class="container">

        <!-- header -->
        <div class="animate-on-scroll from-bottom text-center max-w-160 mx-auto mb-10 md:mb-16">
            <span class="inline-block text-xs font-semibold tracking-[0.12em] uppercase text-(--cryo-primary) mb-3">Core Features</span>
            <h2 class="text-[clamp(1.75rem,3vw,2.5rem)] font-bold leading-tight text-(--cryo-text) mb-4">Everything your network needs.</h2>
            <p class="text-[1.0625rem] text-(--cryo-text-soft) leading-[1.7]">
                Built from the ground up for Minecraft networks that need reliability,
                speed, and full control over their infrastructure.
            </p>
        </div>

        <!-- grid -->
        <div class="features-grid">

            <!-- Node & Wrapper — wide card with interactive architecture -->
            <div class="animate-on-scroll from-bottom card-node relative flex flex-col bg-(--cryo-surface) border border-(--cryo-border) rounded-(--cryo-radius-lg) overflow-hidden transition-[border-color,box-shadow] duration-220 hover:border-[rgba(111,220,255,0.3)] hover:shadow-[0_0_32px_rgba(111,220,255,0.06)]">

                <!-- Header -->
                <div class="p-7 pb-0">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="size-10.5 flex items-center justify-center bg-(--cryo-frost) border border-(--cryo-border) rounded-(--cryo-radius-sm) text-(--cryo-primary)">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-widest text-(--cryo-primary) bg-[rgba(111,220,255,0.08)] border border-[rgba(111,220,255,0.25)]">
                            <span class="arch-pulse-dot inline-block size-1.5 rounded-full bg-(--cryo-primary)"></span>
                            Distributed
                        </span>
                    </div>
                    <h3 class="text-[1.0625rem] font-bold text-(--cryo-text) mb-2.5">Node &amp; Wrapper Architecture</h3>
                    <p class="text-[0.9rem] text-(--cryo-text-soft) leading-[1.65] mb-6 max-w-176">
                        A central <strong class="text-(--cryo-primary) font-semibold">Node</strong> orchestrates your entire network, while
                        <strong class="text-(--cryo-primary) font-semibold">Wrappers</strong> spawn and supervise individual services on every machine.
                        Run it all on a single host or spread it across your infrastructure — <span class="text-(--cryo-text)">same config, same API.</span>
                    </p>
                </div>

                <!-- Architecture Diagram -->
                <div id="architecture-diagram" class="px-7 pb-7 flex flex-col flex-1">
                    <div class="relative flex-1 min-h-0 rounded-(--cryo-radius-md) border border-[rgba(111,220,255,0.1)] bg-[rgba(111,220,255,0.03)] p-4">
                        <svg viewBox="0 0 740 360" class="w-full h-full" role="img"
                             aria-label="Diagram: a central Node orchestrates Wrappers, and each Wrapper spawns and supervises the actual services.">
                            <defs>
                                <linearGradient id="arch-node-stroke" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0%" stop-color="#6fdcff"/>
                                    <stop offset="100%" stop-color="#8a7dff"/>
                                </linearGradient>
                                <linearGradient id="arch-node-fill" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="rgba(111,220,255,0.20)"/>
                                    <stop offset="100%" stop-color="rgba(138,125,255,0.08)"/>
                                </linearGradient>
                                <filter id="arch-glow" x="-60%" y="-60%" width="220%" height="220%">
                                    <feGaussianBlur stdDeviation="4" result="b"/>
                                    <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
                                </filter>
                            </defs>

                            <!-- tier headers -->
                            <text x="94"  y="26" text-anchor="middle" fill="rgba(156,184,204,0.55)" font-size="10" font-weight="700" letter-spacing="2">NODE</text>
                            <text x="325" y="26" text-anchor="middle" fill="rgba(156,184,204,0.55)" font-size="10" font-weight="700" letter-spacing="2">WRAPPERS</text>
                            <text x="605" y="26" text-anchor="middle" fill="rgba(156,184,204,0.55)" font-size="10" font-weight="700" letter-spacing="2">SERVICES</text>

                            <!-- connectors: Node → Wrappers (cyan) -->
                            <path id="arch-n1" d="M158,170 C 200,170 208,118 250,118" fill="none" stroke="rgba(111,220,255,0.32)" stroke-width="1.5" stroke-linecap="round"/>
                            <path id="arch-n2" d="M158,190 C 200,190 208,244 250,244" fill="none" stroke="rgba(111,220,255,0.32)" stroke-width="1.5" stroke-linecap="round"/>
                            <!-- connectors: Wrappers → Services (green) -->
                            <path id="arch-a1" d="M400,108 C 445,108 455,85  500,85"  fill="none" stroke="rgba(79,255,176,0.30)" stroke-width="1.5" stroke-linecap="round"/>
                            <path id="arch-a2" d="M400,128 C 445,128 455,147 500,147" fill="none" stroke="rgba(79,255,176,0.30)" stroke-width="1.5" stroke-linecap="round"/>
                            <path id="arch-b1" d="M400,234 C 445,234 455,217 500,217" fill="none" stroke="rgba(79,255,176,0.30)" stroke-width="1.5" stroke-linecap="round"/>
                            <path id="arch-b2" d="M400,254 C 445,254 455,279 500,279" fill="none" stroke="rgba(255,214,111,0.30)" stroke-width="1.5" stroke-linecap="round"/>

                            <!-- flowing data packets — fade in/out as they travel -->
                            <circle class="arch-packet" r="3" fill="#6fdcff" style="filter:drop-shadow(0 0 3px #6fdcff)">
                                <animateMotion dur="2.2s" repeatCount="indefinite"><mpath href="#arch-n1"/></animateMotion>
                                <animate attributeName="opacity" dur="2.2s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.18;0.82;1"/>
                            </circle>
                            <circle class="arch-packet" r="3" fill="#6fdcff" style="filter:drop-shadow(0 0 3px #6fdcff)">
                                <animateMotion dur="2.2s" begin="-1.1s" repeatCount="indefinite"><mpath href="#arch-n1"/></animateMotion>
                                <animate attributeName="opacity" dur="2.2s" begin="-1.1s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.18;0.82;1"/>
                            </circle>
                            <circle class="arch-packet" r="3" fill="#6fdcff" style="filter:drop-shadow(0 0 3px #6fdcff)">
                                <animateMotion dur="2.2s" begin="-0.6s" repeatCount="indefinite"><mpath href="#arch-n2"/></animateMotion>
                                <animate attributeName="opacity" dur="2.2s" begin="-0.6s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.18;0.82;1"/>
                            </circle>
                            <circle class="arch-packet" r="3" fill="#6fdcff" style="filter:drop-shadow(0 0 3px #6fdcff)">
                                <animateMotion dur="2.2s" begin="-1.7s" repeatCount="indefinite"><mpath href="#arch-n2"/></animateMotion>
                                <animate attributeName="opacity" dur="2.2s" begin="-1.7s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.18;0.82;1"/>
                            </circle>
                            <circle class="arch-packet" r="2.6" fill="#4fffb0" style="filter:drop-shadow(0 0 3px #4fffb0)">
                                <animateMotion dur="1.8s" begin="-0.2s" repeatCount="indefinite"><mpath href="#arch-a1"/></animateMotion>
                                <animate attributeName="opacity" dur="1.8s" begin="-0.2s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.2;0.8;1"/>
                            </circle>
                            <circle class="arch-packet" r="2.6" fill="#4fffb0" style="filter:drop-shadow(0 0 3px #4fffb0)">
                                <animateMotion dur="1.8s" begin="-0.9s" repeatCount="indefinite"><mpath href="#arch-a2"/></animateMotion>
                                <animate attributeName="opacity" dur="1.8s" begin="-0.9s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.2;0.8;1"/>
                            </circle>
                            <circle class="arch-packet" r="2.6" fill="#4fffb0" style="filter:drop-shadow(0 0 3px #4fffb0)">
                                <animateMotion dur="1.8s" begin="-1.3s" repeatCount="indefinite"><mpath href="#arch-b1"/></animateMotion>
                                <animate attributeName="opacity" dur="1.8s" begin="-1.3s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.2;0.8;1"/>
                            </circle>
                            <circle class="arch-packet" r="2.6" fill="#ffd66f" style="filter:drop-shadow(0 0 3px #ffd66f)">
                                <animateMotion dur="1.8s" begin="-0.5s" repeatCount="indefinite"><mpath href="#arch-b2"/></animateMotion>
                                <animate attributeName="opacity" dur="1.8s" begin="-0.5s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;0.2;0.8;1"/>
                            </circle>

                            <!-- ── Services ─────────────────────────────────── -->
                            <!-- Service A1: Proxy -->
                            <g>
                                <rect x="500" y="58" width="210" height="54" rx="10" fill="rgba(79,255,176,0.06)" stroke="rgba(79,255,176,0.3)" stroke-width="1.3"/>
                                <circle class="arch-status" cx="520" cy="85" r="4" fill="rgb(79,255,176)"/>
                                <text x="536" y="81" fill="#e8f7ff" font-size="13" font-weight="700">Proxy</text>
                                <text x="536" y="97" fill="rgba(156,184,204,0.8)" font-size="9.5">Velocity</text>
                                <text x="694" y="84" text-anchor="end" fill="rgba(79,255,176,0.7)" font-size="8" font-weight="700" letter-spacing="0.8">RUNNING</text>
                            </g>
                            <!-- Service A2: Lobby -->
                            <g>
                                <rect x="500" y="120" width="210" height="54" rx="10" fill="rgba(79,255,176,0.06)" stroke="rgba(79,255,176,0.3)" stroke-width="1.3"/>
                                <circle class="arch-status" cx="520" cy="147" r="4" fill="rgb(79,255,176)" style="animation-delay:.4s"/>
                                <text x="536" y="143" fill="#e8f7ff" font-size="13" font-weight="700">Lobby</text>
                                <text x="536" y="159" fill="rgba(156,184,204,0.8)" font-size="9.5">Paper</text>
                                <text x="694" y="146" text-anchor="end" fill="rgba(79,255,176,0.7)" font-size="8" font-weight="700" letter-spacing="0.8">RUNNING</text>
                            </g>
                            <!-- Service B1: Survival -->
                            <g>
                                <rect x="500" y="190" width="210" height="54" rx="10" fill="rgba(79,255,176,0.06)" stroke="rgba(79,255,176,0.3)" stroke-width="1.3"/>
                                <circle class="arch-status" cx="520" cy="217" r="4" fill="rgb(79,255,176)" style="animation-delay:.8s"/>
                                <text x="536" y="213" fill="#e8f7ff" font-size="13" font-weight="700">Survival</text>
                                <text x="536" y="229" fill="rgba(156,184,204,0.8)" font-size="9.5">Paper</text>
                                <text x="694" y="216" text-anchor="end" fill="rgba(79,255,176,0.7)" font-size="8" font-weight="700" letter-spacing="0.8">RUNNING</text>
                            </g>
                            <!-- Service B2: BedWars (starting) -->
                            <g>
                                <rect x="500" y="252" width="210" height="54" rx="10" fill="rgba(255,214,111,0.06)" stroke="rgba(255,214,111,0.32)" stroke-width="1.3"/>
                                <circle class="arch-status" cx="520" cy="279" r="4" fill="rgb(255,214,111)" style="animation-delay:.2s"/>
                                <text x="536" y="275" fill="#e8f7ff" font-size="13" font-weight="700">BedWars</text>
                                <text x="536" y="291" fill="rgba(156,184,204,0.8)" font-size="9.5">Paper</text>
                                <text x="694" y="278" text-anchor="end" fill="rgba(255,214,111,0.8)" font-size="8" font-weight="700" letter-spacing="0.8">STARTING</text>
                            </g>

                            <!-- ── Wrappers ─────────────────────────────────── -->
                            <!-- Wrapper 1 -->
                            <g>
                                <rect x="250" y="78" width="150" height="80" rx="12" fill="rgba(111,220,255,0.08)" stroke="rgba(111,220,255,0.4)" stroke-width="1.5"/>
                                <text x="266" y="100" fill="rgba(111,220,255,0.85)" font-size="9" font-weight="700" letter-spacing="1.2">WRAPPER</text>
                                <circle class="arch-status" cx="384" cy="96" r="4" fill="rgb(111,220,255)"/>
                                <text x="266" y="124" fill="#e8f7ff" font-size="14" font-weight="700">wrapper-1</text>
                                <text x="266" y="142" fill="rgba(156,184,204,0.8)" font-size="10">2 services</text>
                            </g>
                            <!-- Wrapper 2 -->
                            <g>
                                <rect x="250" y="204" width="150" height="80" rx="12" fill="rgba(138,125,255,0.08)" stroke="rgba(138,125,255,0.4)" stroke-width="1.5"/>
                                <text x="266" y="226" fill="rgba(184,178,255,0.9)" font-size="9" font-weight="700" letter-spacing="1.2">WRAPPER</text>
                                <circle class="arch-status" cx="384" cy="222" r="4" fill="rgb(138,125,255)" style="animation-delay:.6s"/>
                                <text x="266" y="250" fill="#e8f7ff" font-size="14" font-weight="700">wrapper-2</text>
                                <text x="266" y="268" fill="rgba(156,184,204,0.8)" font-size="10">2 services</text>
                            </g>

                            <!-- ── Node (drawn last, above connector roots) ──── -->
                            <g filter="url(#arch-glow)">
                                <rect x="30" y="124" width="128" height="112" rx="16" fill="url(#arch-node-fill)" stroke="url(#arch-node-stroke)" stroke-width="2"/>
                            </g>
                            <rect x="78" y="138" width="32" height="30" rx="8" fill="rgba(111,220,255,0.18)" stroke="rgba(111,220,255,0.5)" stroke-width="1.2"/>
                            <rect x="85" y="145" width="18" height="3.5" rx="1.75" fill="#6fdcff"/>
                            <rect x="85" y="151.5" width="18" height="3.5" rx="1.75" fill="#8a7dff"/>
                            <rect x="85" y="158" width="18" height="3.5" rx="1.75" fill="#6fdcff"/>
                            <text x="94" y="192" text-anchor="middle" fill="#b9f3ff" font-size="15" font-weight="700">Node</text>
                            <text x="94" y="208" text-anchor="middle" fill="rgba(156,184,204,0.85)" font-size="10">Orchestrator</text>
                            <circle class="arch-status" cx="78" cy="222" r="3.5" fill="#4fffb0"/>
                            <text x="88" y="225.5" fill="rgba(79,255,176,0.9)" font-size="9.5" font-weight="600">Online</text>
                            <circle cx="158" cy="170" r="3" fill="#6fdcff"/>
                            <circle cx="158" cy="190" r="3" fill="#6fdcff"/>
                        </svg>
                    </div>

                    <!-- Capability strip -->
                    <div class="grid grid-cols-3 gap-3 mt-6 max-sm:grid-cols-1">
                        <div class="flex items-start gap-3 rounded-(--cryo-radius-sm) border border-[rgba(111,220,255,0.2)] bg-[rgba(111,220,255,0.05)] p-3.5">
                            <svg class="shrink-0 mt-0.5 text-(--cryo-primary)" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>
                            <div>
                                <div class="text-[0.78rem] font-semibold text-(--cryo-primary) mb-0.5">Deployment</div>
                                <div class="text-[0.8rem] text-(--cryo-text-soft) leading-snug">Single host or distributed across machines</div>
                            </div>
                        </div>
                        <div class="flex items-start gap-3 rounded-(--cryo-radius-sm) border border-[rgba(79,255,176,0.2)] bg-[rgba(79,255,176,0.05)] p-3.5">
                            <svg class="shrink-0 mt-0.5 text-(--cryo-success)" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
                            <div>
                                <div class="text-[0.78rem] font-semibold text-(--cryo-success) mb-0.5">Auto-Managed</div>
                                <div class="text-[0.8rem] text-(--cryo-text-soft) leading-snug">No manual service handling required</div>
                            </div>
                        </div>
                        <div class="flex items-start gap-3 rounded-(--cryo-radius-sm) border border-[rgba(255,214,111,0.2)] bg-[rgba(255,214,111,0.05)] p-3.5">
                            <svg class="shrink-0 mt-0.5 text-(--cryo-warning)" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1.5" y1="14" x2="6.5" y2="14"/><line x1="9.5" y1="8" x2="14.5" y2="8"/><line x1="17.5" y1="16" x2="22.5" y2="16"/></svg>
                            <div>
                                <div class="text-[0.78rem] font-semibold text-(--cryo-warning) mb-0.5">Unified Config</div>
                                <div class="text-[0.8rem] text-(--cryo-text-soft) leading-snug">One API for every service</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Auto Forwarding -->
            <div class="animate-on-scroll from-right card-forward bg-(--cryo-surface) border border-(--cryo-border) rounded-(--cryo-radius-lg) p-7 transition-[border-color,box-shadow] duration-220 hover:border-[rgba(111,220,255,0.3)] hover:shadow-[0_0_32px_rgba(111,220,255,0.06)]">
                <div class="size-10.5 flex items-center justify-center bg-(--cryo-frost) border border-(--cryo-border) rounded-(--cryo-radius-sm) mb-4 text-(--cryo-primary)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3 class="text-[1.0625rem] font-bold text-(--cryo-text) mb-2.5">Auto Forwarding Setup</h3>
                <p class="text-[0.9rem] text-(--cryo-text-soft) leading-[1.65]">
                    Velocity modern forwarding and BungeeCord legacy forwarding — both supported.
                    Set to <code class="feature-code">AUTO</code> and KryoCloud detects your proxy software and configures
                    the shared secret automatically across all services.
                </p>
                <div class="flex flex-wrap gap-2 mt-5">
                    {["Velocity","BungeeCord","Waterfall","Flamecord"].map(name => (
                        <span class="px-3 py-1 rounded-full text-[0.75rem] font-semibold border bg-[rgba(111,220,255,0.08)] border-[rgba(111,220,255,0.3)] text-(--cryo-primary)">{name}</span>
                    ))}
                </div>
            </div>

            <!-- Smart Service Groups -->
            <div class="animate-on-scroll from-right card-smart bg-(--cryo-surface) border border-(--cryo-border) rounded-(--cryo-radius-lg) p-7 transition-[border-color,box-shadow] duration-220 hover:border-[rgba(111,220,255,0.3)] hover:shadow-[0_0_32px_rgba(111,220,255,0.06)]">
                <div class="size-10.5 flex items-center justify-center bg-(--cryo-frost) border border-(--cryo-border) rounded-(--cryo-radius-sm) mb-4 text-(--cryo-primary)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                </div>
                <h3 class="text-[1.0625rem] font-bold text-(--cryo-text) mb-2.5">Smart Service Groups</h3>
                <p class="text-[0.9rem] text-(--cryo-text-soft) leading-[1.65]">
                    Define groups with min/max service counts, memory limits, and auto-scale thresholds.
                    KryoCloud automatically starts new services when usage exceeds your configured
                    <code class="feature-code">startNewPercent</code> — no manual intervention required.
                </p>
                <!-- scale bar demo -->
                <div class="mt-5 flex flex-col gap-1.5">
                    <div class="flex justify-between items-center">
                        <span class="text-[0.75rem] text-(--cryo-text-muted)">Usage</span>
                        <div class="flex items-center gap-1.5">
                            <span class="text-[0.75rem] font-bold text-(--cryo-primary)">82%</span>
                            <span class="text-[0.7rem] text-(--cryo-success) font-semibold">↑ Spawning</span>
                        </div>
                    </div>
                    <div class="relative h-2 bg-(--cryo-frost-strong) rounded-full overflow-visible">
                        <div class="h-full w-[82%] bg-(--cryo-gradient-primary) rounded-full"></div>
                        <div class="absolute -top-0.75 left-[80%] w-0.5 h-3.5 bg-(--cryo-warning) rounded-sm -translate-x-1/2"></div>
                    </div>
                    <span class="text-[0.7rem] text-(--cryo-text-muted)">Threshold at 80% — new service spawning</span>
                </div>
            </div>

            <!-- Template System -->
            <div class="animate-on-scroll from-bottom card-template bg-(--cryo-surface) border border-(--cryo-border) rounded-(--cryo-radius-lg) p-7 transition-[border-color,box-shadow] duration-220 hover:border-[rgba(111,220,255,0.3)] hover:shadow-[0_0_32px_rgba(111,220,255,0.06)]">
                <div class="size-10.5 flex items-center justify-center bg-(--cryo-frost) border border-(--cryo-border) rounded-(--cryo-radius-sm) mb-4 text-(--cryo-primary)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <h3 class="text-[1.0625rem] font-bold text-(--cryo-text) mb-2.5">Template System</h3>
                <p class="text-[0.9rem] text-(--cryo-text-soft) leading-[1.65]">
                    Every service group is backed by a template. Persistent static services keep their directory
                    across restarts; ephemeral services get a fresh copy every launch — the right model for
                    proxies vs. minigame servers.
                </p>
            </div>

            <!-- Service Lifecycle -->
            <div class="animate-on-scroll from-bottom card-lifecycle bg-(--cryo-surface) border border-(--cryo-border) rounded-(--cryo-radius-lg) p-7 transition-[border-color,box-shadow] duration-220 hover:border-[rgba(111,220,255,0.3)] hover:shadow-[0_0_32px_rgba(111,220,255,0.06)]">
                <div class="size-10.5 flex items-center justify-center bg-(--cryo-frost) border border-(--cryo-border) rounded-(--cryo-radius-sm) mb-4 text-(--cryo-primary)">
