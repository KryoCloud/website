---
import ConsoleWindow from "./ConsoleWindow.astro";

const col = (cls: string, t: string) => `<span class="${cls}">${t}</span>`;
const p = (t: string) => col("con-primary", t);
const s = (t: string) => col("con-success", t);
const w = (t: string) => col("con-warn",    t);
const e = (t: string) => col("con-error",   t);
const m = (t: string) => col("con-muted",   t);
const c = (t: string) => col("con-cls",     t);
const b = (t: string) => col("con-bold",    t);

function log(time: string, level: string, cls: string, msg: string) {
    const lvl =
        level === "OK"    ? s("OK   ") :
        level === "WARN"  ? w("WARN ") :
        level === "ERROR" ? e("ERROR") :
                            m("INFO ");
    return `${p("❄")} ${m(time)}  ${lvl}  ${c(cls.padEnd(20))}  ${msg}`;
}

const div = m("─".repeat(60));

const heroLines = [
    `${p("❄")}  ${b("KryoCloud")}  ${m("⋄  node")}`,
    div,
    m("frost-tier minecraft cloud"),
    ``,
    `${s("✓")}  wrappers`,
    `${s("✓")}  groups`,
    `${s("✓")}  versions`,
    `${s("✓")}  commands`,
    `${s("✓")}  ${b("ready")}`,
    ``,
    `${p("❄")}  ${b("KryoCloud console ready")}`,
    ``,
    `${m("Service")} Lobby-1 ${m("is now")} ${w("PREPARING")} ${m("on wrapper-1")}`,
    log("15:00:00", "WARN", "TemurinInstaller", "Downloading Temurin Java 25 from adoptium.net"),
    log("15:00:02", "OK",   "TemurinInstaller", `Installed Temurin Java 25 into ${m(".jdk/java-25")}`),
    `${m("Service")} Lobby-1 ${m("is now")} ${p("STARTING")} ${m("on wrapper-1")}`,
    log("15:00:05", "OK",   "InstanceManager",  `Started ${b("Lobby-1")} in screen on port ${m("34749")}`),
    `${m("Service")} Lobby-1 ${m("is now")} ${s("RUNNING")} ${m("on wrapper-1")}`,
];
---

<section class="relative pt-32 pb-12 sm:pt-44 sm:pb-20 text-center" style="background: radial-gradient(ellipse 50% 45% at 12% 42%, rgba(111,220,255,0.14) 0%, transparent 70%), radial-gradient(ellipse 50% 45% at 88% 42%, rgba(138,125,255,0.14) 0%, transparent 70%);">
    <div class="absolute bottom-0 inset-x-0 h-32 bg-linear-to-t from-(--cryo-bg) to-transparent pointer-events-none"></div>

    <div class="container relative">

        <h1 class="animate-on-scroll show-up text-[clamp(2rem,5vw,4rem)] font-extrabold leading-[1.1] text-(--cryo-text) mb-5 sm:mb-6 tracking-[-0.02em]">
            The Cloud System<br />
            <span class="gradient-text">Minecraft deserves.</span>
        </h1>

        <p class="animate-on-scroll show-up text-[1rem] sm:text-[1.125rem] text-(--cryo-text-soft) leading-[1.7] max-w-150 mx-auto mb-8 sm:mb-10">
            KryoCloud is a lightweight, extensible cloud management system for Minecraft networks.
            Start services, manage groups, and extend everything through a clean plugin API —
            all from one node.
        </p>

        <div class="animate-on-scroll show-up flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 mb-10 sm:mb-16 px-4 sm:px-0">
            <a href="https://docs.kryocloud.eu/getting-started" target="_blank" class="btn-primary justify-center">
                Get Started
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="https://docs.kryocloud.eu" target="_blank" class="btn-ghost justify-center">Read the Docs</a>
        </div>

        <ConsoleWindow title="kryocloud.jar" lines={heroLines} class="animate-on-scroll from-bottom max-w-250 mx-auto text-left shadow-(--cryo-shadow-lg)" />
    </div>
</section>

