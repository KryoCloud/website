---
const installCmd = `curl -fsSL https://kryocloud.eu/install.sh | bash`;
---

<section class="relative py-14 md:py-24 text-center overflow-hidden border-t border-(--cryo-border)">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-175 h-75 bg-[radial-gradient(ellipse,rgba(111,220,255,0.08)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="container relative">
        <h2 class="animate-on-scroll from-bottom text-[clamp(2rem,4vw,3rem)] font-extrabold text-(--cryo-text) mb-4 tracking-[-0.02em]">
            Ready to freeze the chaos?
        </h2>
        <p class="animate-on-scroll from-bottom text-[1rem] sm:text-[1.0625rem] text-(--cryo-text-soft) max-w-130 mx-auto mb-7 sm:mb-10 leading-[1.7]">
            Get KryoCloud running in minutes. One command, your entire network under control.
        </p>

        <!-- install command -->
        <div class="animate-on-scroll from-bottom inline-flex items-center gap-3 px-4 py-3 sm:px-5 sm:py-3.5 bg-(--cryo-surface) border border-(--cryo-border) rounded-(--cryo-radius-md) mb-7 sm:mb-10 max-w-full group hover:border-(--cryo-primary) transition-colors duration-220">
            <span class="text-(--cryo-text-muted) text-sm shrink-0">$</span>
            <code id="install-cmd" class="code-font text-sm text-(--cryo-text-soft) group-hover:text-(--cryo-text) transition-colors duration-220 overflow-x-auto whitespace-nowrap">{installCmd}</code>
            <button
                id="copy-btn"
                aria-label="Copy install command"
                class="shrink-0 ml-2 text-(--cryo-text-muted) hover:text-(--cryo-primary) transition-colors duration-220"
            >
                <svg id="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <svg id="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
        </div>

        <p class="text-xs text-(--cryo-text-muted) mb-10">Linux &amp; macOS · Requires curl &amp; bash</p>

        <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4 px-4 sm:px-0">
            <a href="https://docs.kryocloud.eu/getting-started" target="_blank" class="btn-primary btn-primary--lg justify-center">
                Read the Docs
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="https://github.com/KryoCloud" target="_blank" rel="noopener" class="btn-ghost btn-ghost--lg justify-center">GitHub</a>
        </div>
    </div>
</section>

<script>
    const btn = document.getElementById("copy-btn");
    const copyIcon = document.getElementById("copy-icon");
    const checkIcon = document.getElementById("check-icon");
    const cmd = document.getElementById("install-cmd")?.textContent ?? "";

    btn?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(cmd);
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        setTimeout(() => {
            copyIcon?.classList.remove("hidden");
            checkIcon?.classList.add("hidden");
        }, 2000);
    });
</script>
