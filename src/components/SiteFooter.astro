---
const links = [
    {
        label: "Documentation",
        href: "https://docs.kryocloud.eu",
        external: true,
    },
    { label: "Changelog", href: "/changelog" },
    { label: "GitHub", href: "https://github.com/KryoCloud", external: true },
];

const legalLinks = [
    { label: "Imprint", href: "https://draconyx.group/imprint", external: true },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-(--cryo-border) py-8 bg-(--cryo-surface)">
    <div class="container">
        <!-- top row: logo + nav -->
        <div class="flex justify-between">
            <div class="flex flex-wrap items-center gap-6 mb-5">
                <div
                    class="flex items-center gap-2 font-bold text-[0.9375rem] text-(--cryo-text)"
                >
                    <img
                        src="/image/logo.png"
                        class="h-7"
                        alt="KryoCloud logo"
                    />
                    <span>KryoCloud</span>
                </div>
                <nav class="flex flex-wrap gap-5">
                    {
                        links.map(({ label, href, external }) => (
                            <a
                                href={href}
                                target={external ? "_blank" : undefined}
                                rel={external ? "noopener" : undefined}
                                class="text-[0.875rem] text-(--cryo-text-muted) no-underline transition-colors duration-120 hover:text-(--cryo-text)"
                            >
                                {label}
                            </a>
                        ))
                    }
                </nav>
            </div>
            <div class="flex flex-wrap items-center gap-6 mb-5">
                <nav class="flex flex-wrap gap-5">
                    {
                        legalLinks.map(({ label, href, external }) => (
                            <a
                                href={href}
                                target={external ? "_blank" : undefined}
                                rel={external ? "noopener" : undefined}
                                class="text-[0.875rem] text-(--cryo-text-muted) no-underline transition-colors duration-120 hover:text-(--cryo-text)"
                            >
                                {label}
                            </a>
                        ))
                    }
                </nav>
            </div>
        </div>
        <!-- bottom row: meta -->
        <div
            class="flex flex-wrap items-center justify-between gap-3 pt-5 border-t border-(--cryo-border)"
        >
            <p class="text-[0.8125rem] text-(--cryo-text-muted)">
                A member of <a
                    href="https://draconyx.group"
                    class="text-(--cryo-primary) hover:underline"
                    >Draconyx Group</a
                >
            </p>
            <p class="text-[0.8125rem] text-(--cryo-text-muted)">
                © {year} KryoCloud. Built for Minecraft networks.
            </p>
        </div>
    </div>
</footer>
