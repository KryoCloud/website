---
const stats = [
    { number: "3",   label: "Service Types" },
    { number: "6",   label: "Service States" },
    { number: "10+", label: "API Controllers" },
    { number: "∞",   label: "Extensible via Plugins" },
];
---

<section class="py-6 border-y border-(--cryo-border) bg-(--cryo-surface)">
    <div class="container">
        <div class="grid grid-cols-2 sm:flex sm:items-center sm:justify-center gap-y-4 sm:gap-y-0">
            {stats.map((stat, i) => (
                <>
                    <div class="animate-on-scroll show-up flex flex-col items-center px-6 sm:px-12 py-2">
                        <span class="text-[1.5rem] sm:text-[1.75rem] font-extrabold leading-none gradient-text">{stat.number}</span>
                        <span class="text-[0.75rem] sm:text-[0.8125rem] text-(--cryo-text-muted) mt-1 text-center">{stat.label}</span>
                    </div>
                    {i < stats.length - 1 && (
                        <div class="hidden sm:block w-px h-10 bg-(--cryo-border)"></div>
                    )}
                </>
            ))}
        </div>
    </div>
</section>
